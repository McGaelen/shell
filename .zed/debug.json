// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug native binary",
    "build": {
      "command": "zig",
      "args": ["cc", "-Wall", "-Werror", "main.c"],
      "cwd": "$ZED_WORKTREE_ROOT/c"
    },
    "program": "$ZED_WORKTREE_ROOT/c/a.out",
    "request": "launch",
    "adapter": "CodeLLDB",
    "args": ["$ZED_WORKTREE_ROOT/basic.txt"]
  },
  {
    "label": "Debug zig",
    "build": {
      "command": "zig",
      "args": ["build", "-Doptimize=debug"],
      "cwd": "$ZED_WORKTREE_ROOT/zig"
    },
    "program": "$ZED_WORKTREE_ROOT/zig/zig-out/bin/zig_practice",
    "request": "launch",
    "adapter": "CodeLLDB",
    "args": ["$ZED_WORKTREE_ROOT/basic.txt"]
  }
]
